# =====================================================================
# DealFinder India — Environment Variable Configuration
# Copy this file to .env.local to configure credentials
# Note: The platform runs seamlessly in Demo Mode even with empty keys!
# =====================================================================

# Public URL of the deployment (used for canonical links and redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------
# Supabase PostgreSQL (Free Tier: 500MB DB, 50,000 monthly active users)
# Leave blank to use high-performance built-in demo repository
# ---------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------
# 1. Flipkart Affiliate API 1.0
# Register at: https://affiliate.flipkart.com/
# ---------------------------------------------------------------------
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=

# ---------------------------------------------------------------------
# 2. Amazon India Associates & PA-API 5.0
# Register at: https://affiliate-program.amazon.in/
# Note: PA-API 5.0 keys require driving 3 qualifying sales within 180 days.
# Direct outbound links with AMAZON_ASSOCIATES_TAG work immediately!
# ---------------------------------------------------------------------
AMAZON_ASSOCIATES_TAG=dealfinder-21
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=

# ---------------------------------------------------------------------
# 3. Myntra & AJIO Affiliate Feeds
# Myntra & AJIO operate via affiliate aggregators like Cuelinks / EarnKaro.
# Register at: https://www.cuelinks.com/
# ---------------------------------------------------------------------
CUELINKS_PUBLISHER_ID=
MYNTRA_FEED_KEY=
AJIO_AFFILIATE_ID=

# ---------------------------------------------------------------------
# 4. Meesho Referral / Reseller
# Register at: https://www.meesho.com/
# ---------------------------------------------------------------------
MEESHO_REFERRAL_CODE=
